# ═══════════════════════════════════════════════════════════════════
# Configuration du backend Node.js (copiez ce fichier en .env)
# ═══════════════════════════════════════════════════════════════════

# Mot de passe d'accès administrateur (vérifié côté serveur uniquement)
ADMIN_PASSWORD=changeme-strong-password

# Port du serveur API (3001 en dev, proxy Vite configuré en conséquence)
# PORT=3001

# Emplacement de la base SQLite (par défaut : ./data/qcm.db)
# DB_PATH=./data/qcm.db

# Dossier de stockage des fichiers (base, ressources de cours, documents IA,
# sauvegardes). Par défaut : ./data. Créé automatiquement.
# DATA_DIR=./data

# Nombre de demandes identiques (faculté + filière + niveau + UE) nécessaires
# pour valider automatiquement une demande de QCM. Défaut : 10.
# QUIZ_REQUEST_THRESHOLD=10

# ── Service SMTP Google (Gmail) pour la récupération de mot de passe ──
# 1. Activez la validation 2FA sur votre compte Google
# 2. Créez un mot de passe d'application (16 caractères) sur
#    https://myaccount.google.com/apppasswords
# (Repli serveur · peut aussi être saisi directement dans le panneau admin)
SMTP_EMAIL=votre-adresse@gmail.com
SMTP_APP_PASSWORD=abcd efgh ijkl mnop

# ── Tuteur IA (proxy serveur, clés jamais exposées au navigateur) ─────
# Plusieurs clés par fournisseur, séparées par des virgules. Elles sont
# utilisées en rotation puis en repli automatique en cas d'erreur ou de quota
# atteint. Aucune clé n'est affichée aux étudiants.
# Groq (gsk_...) : https://console.groq.com/keys
GROQ_API_KEYS=gsk_cle1,gsk_cle2,gsk_cle3
# Gratuit et sans carte bancaire : https://aistudio.google.com/apikey
GEMINI_API_KEYS=cle_gemini_1,cle_gemini_2

# Pour ajouter 3 clés Groq sans toucher à la variable ci-dessus :
# GROQ_API_KEYS_EXTRA=gsk_cle4,gsk_cle5,gsk_cle6
# Clés xAI / Grok (les deux noms sont acceptés) :
# GROK_API_KEYS=cle1,cle2,cle3
# GROK_API_KEY=cle1
# XAI_API_KEYS=cle1,cle2,cle3
# XAI_API_KEY=cle1

# Option chinoise : Qwen / Alibaba DashScope (compatible OpenAI)
# Clé : https://bailian.console.aliyun.com/ (région internationale / Singapour)
# DASHSCOPE_API_KEY=sk-cle_qwen
# DASHSCOPE_MODEL=qwen3.8-flash
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions

# Modèles utilisés (facultatifs, valeurs par défaut ci-dessous)
# GROQ_MODEL=openai/gpt-oss-120b
# GROK_MODEL=grok-3-mini
# gemini-2.0-flash est arrêté : nouveau défaut ci-dessous
# GEMINI_MODEL=gemini-3.5-flash-lite

# Quotas du tuteur : questions maximum par erreur (24 h), questions générales
# par jour, et plafond quotidien par étudiant.
# AI_MAX_QUESTIONS_PER_ERROR=2
# AI_GENERAL_LIMIT=5
# AI_DAILY_LIMIT=30

# Robustesse : un essai court, un budget total borné, puis un message actionnable
# (« reformulez votre prompt » ou « revenez plus tard ») au lieu d'une attente
# indéfinie. Le texte tronqué est poursuivi avant d'être affiché.
# AI_REQUEST_TIMEOUT_MS=15000
# AI_TOTAL_TIMEOUT_MS=65000
# AI_KEY_COOLDOWN_MS=45000

# Taille des générations à partir de documents. Une requête compte les tokens
# d'entrée ET le budget de sortie : avec une offre Groq limitée à 8 000 TPM,
# garder ces valeurs (ou les baisser) évite les erreurs 413 « Request too large ».
# Le contexte est réduit automatiquement si le fournisseur refuse la requête.
# AI_MAX_CONTEXT_CHARS=10000
# AI_MAX_OUTPUT_TOKENS=3000

# Budget mensuel de tokens affiché dans le tableau de bord admin.
# Les tokens restants = budget − tokens consommés depuis le 1er du mois.
# 0 désactive le plafond (la consommation reste suivie).
# AI_TOKEN_BUDGET=1000000

# ── Sauvegarde automatique de la base SQLite ──────────────────────────
# Une copie cohérente est créée au démarrage puis à intervalle régulier.
# Les fichiers sont conservés dans BACKUP_DIR avec rotation (BACKUP_MAX).
BACKUP_ENABLED=true
# BACKUP_INTERVAL_HOURS=6
# BACKUP_MAX=10
# BACKUP_DIR=./data/backups

# ── Notifications push Android (Firebase Cloud Messaging) ─────────────
# Optionnel : sans configuration, les notifications internes et les e-mails
# continuent de fonctionner, seuls les push et les rappels programmés sont
# désactivés.
# 1. Créez un projet Firebase et une application Android
#    (package : org.qcmapp.app).
# 2. Téléchargez google-services.json dans android/app/ pour le build APK.
# 3. Générez un compte de service (JSON) et collez son contenu ici sur une
#    seule ligne, ou utilisez GOOGLE_APPLICATION_CREDENTIALS sur le VPS.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/chemin/vers/service-account.json
